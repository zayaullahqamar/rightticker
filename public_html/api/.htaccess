# RightTicker API Security Config
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, X-Watchlist-Mode"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "\.(sqlite|db|log|json|lock)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>
